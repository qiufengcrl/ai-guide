{
  "id": "ai-guide",
  "name": "AI 攻略",
  "version": "1.1.32",
  "apiVersion": 1,
  "author": "Your Name",
  "description": "把小红书旅行攻略转换为可编辑的 TREK 地图行程",
  "type": "page",
  "trek": ">=4.0.0 <5.0.0",
  "nativeModules": false,
  "permissions": [
    "ai:invoke",
    "db:own",
    "db:create:trips",
    "db:read:trips",
    "db:write:places",
    "db:write:itinerary",
    "db:read:categories",
    "db:meta",
    "hook:user-data",
    "http:outbound:www.xiaohongshu.com",
    "http:outbound:edith.xiaohongshu.com",
    "http:outbound:xhslink.com",
    "http:outbound:xhslink.cn",
    "http:outbound:nominatim.openstreetmap.org",
    "http:outbound:trek-amap-bridge"
  ],
  "requiredAddons": [
    "llm_parsing"
  ],
  "pluginDependencies": [],
  "icon": "Sparkles",
  "egress": [
    "www.xiaohongshu.com",
    "edith.xiaohongshu.com",
    "xhslink.com",
    "xhslink.cn",
    "nominatim.openstreetmap.org",
    "trek-amap-bridge"
  ],
  "settings": [
    {
      "key": "max_days",
      "label": "最大行程天数",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "8",
      "hint": "最多 14 天"
    },
    {
      "key": "max_places_per_day",
      "label": "每日最多地点数",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "6"
    },
    {
      "key": "max_notes",
      "label": "最多读取攻略数",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "4",
      "hint": "最多 8 篇"
    },
    {
      "key": "xhs_enabled",
      "label": "启用小红书关键词搜索",
      "input_type": "checkbox",
      "scope": "instance",
      "default": false,
      "hint": "管理员总开关。关闭后，攻略生成页不会出现小红书搜索选项，用户也无法通过接口开启"
    },
    {
      "key": "places_api_base",
      "label": "地图搜索服务地址",
      "input_type": "text",
      "scope": "instance",
      "placeholder": "http://trek-amap-bridge:8080",
      "hint": "与 TREK 的 PLACES_API_BASE 一致；留空则回退到 OpenStreetMap Nominatim"
    },
    {
      "key": "places_api_key",
      "label": "地图搜索 API Key",
      "input_type": "password",
      "scope": "instance",
      "secret": true,
      "hint": "与 TREK 的 PLACES_API_KEY 一致；配合上面的地址使用高德/Google Places 兼容 bridge"
    },
    {
      "key": "xhs_cookie",
      "label": "小红书 Web Cookie",
      "input_type": "password",
      "scope": "user",
      "secret": true,
      "hint": "登录 www.xiaohongshu.com 后粘贴完整 Cookie，须含 a1 和 web_session。仅服务端使用，不会进页面或 AI。"
    },
    {
      "key": "xhs_cookie_updated_at",
      "label": "Cookie 最近验证时间",
      "input_type": "text",
      "scope": "user",
      "hint": "毫秒时间戳，由插件在 Cookie 验证成功时自动记录；超过 7 天会在生成前非阻断提醒。无需手动填写，请勿把 Cookie 贴到这里。"
    }
  ],
  "actions": [
    {
      "key": "testXhs",
      "label": "测试小红书会话",
      "hint": "请先保存 Cookie，再点测试。执行一次最小关键词搜索（约数秒）。"
    }
  ]
}
