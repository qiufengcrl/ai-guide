{
  "id": "ai-guide",
  "name": "AI 攻略",
  "version": "1.1.11",
  "apiVersion": 1,
  "author": "Your Name",
  "description": "把小红书旅行攻略转换为可编辑的 TREK 地图行程",
  "type": "page",
  "trek": ">=4.0.0 <5.0.0",
  "nativeModules": false,
  "permissions": [
    "ai:invoke",
    "db:own",
    "db:create:trips",
    "db:read:trips",
    "db:write:places",
    "db:write:itinerary",
    "db:read:categories",
    "db:meta",
    "hook:user-data",
    "http:outbound:www.xiaohongshu.com",
    "http:outbound:edith.xiaohongshu.com",
    "http:outbound:xhslink.com",
    "http:outbound:xhslink.cn",
    "http:outbound:nominatim.openstreetmap.org"
  ],
  "requiredAddons": [
    "llm_parsing"
  ],
  "pluginDependencies": [],
  "icon": "Sparkles",
  "egress": [
    "www.xiaohongshu.com",
    "edith.xiaohongshu.com",
    "xhslink.com",
    "xhslink.cn",
    "nominatim.openstreetmap.org"
  ],
  "settings": [
    {
      "key": "max_days",
      "label": "最大行程天数",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "8",
      "hint": "最多 14 天"
    },
    {
      "key": "max_places_per_day",
      "label": "每日最多地点数",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "6"
    },
    {
      "key": "max_notes",
      "label": "最多读取攻略数",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "4",
      "hint": "最多 8 篇"
    },
    {
      "key": "xhs_enabled",
      "label": "尝试小红书关键词搜索",
      "input_type": "select",
      "scope": "instance",
      "options": [
        { "value": "true", "label": "启用" },
        { "value": "false", "label": "停用" }
      ]
    },
    {
      "key": "xhs_cookie",
      "label": "小红书 Web Cookie",
      "input_type": "password",
      "scope": "user",
      "secret": true,
      "hint": "仅由插件服务端处理你的请求；不会发送到页面、AI 提示词、日志或草稿。"
    }
  ],
  "actions": [
    {
      "key": "testXhs",
      "label": "测试小红书会话",
      "hint": "使用你的 Cookie 执行一次最小关键词搜索。"
    }
  ]
}
