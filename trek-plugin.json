{
  "id": "ai-guide",
  "name": "AI 攻略",
  "version": "1.1.15",
  "apiVersion": 1,
  "author": "Your Name",
  "description": "把小红书旅行攻略转换为可编辑的 TREK 地图行程",
  "type": "page",
  "trek": ">=4.0.0 <5.0.0",
  "nativeModules": false,
  "permissions": [
    "ai:invoke",
    "db:own",
    "db:create:trips",
    "db:read:trips",
    "db:write:places",
    "db:write:itinerary",
    "db:read:categories",
    "db:meta",
    "hook:user-data",
    "http:outbound:www.xiaohongshu.com",
    "http:outbound:edith.xiaohongshu.com",
    "http:outbound:xhslink.com",
    "http:outbound:xhslink.cn",
    "http:outbound:nominatim.openstreetmap.org",
    "http:outbound:trek-amap-bridge"
  ],
  "requiredAddons": [
    "llm_parsing"
  ],
  "pluginDependencies": [],
  "icon": "Sparkles",
  "egress": [
    "www.xiaohongshu.com",
    "edith.xiaohongshu.com",
    "xhslink.com",
    "xhslink.cn",
    "nominatim.openstreetmap.org",
    "trek-amap-bridge"
  ],
  "settings": [
    {
      "key": "max_days",
      "label": "最大行程天数",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "8",
      "hint": "最多 14 天"
    },
    {
      "key": "max_places_per_day",
      "label": "每日最多地点数",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "6"
    },
    {
      "key": "max_notes",
      "label": "最多读取攻略数",
      "input_type": "number",
      "scope": "instance",
      "placeholder": "4",
      "hint": "最多 8 篇"
    },
    {
      "key": "xhs_enabled",
      "label": "允许小红书关键词搜索",
      "input_type": "select",
      "scope": "instance",
      "default": "false",
      "hint": "关闭后，用户无法在生成页启用关键词搜索（仍可使用链接与粘贴正文）",
      "options": [
        { "value": "true", "label": "允许" },
        { "value": "false", "label": "不允许" }
      ]
    },
    {
      "key": "places_api_base",
      "label": "地图搜索服务地址",
      "input_type": "text",
      "scope": "instance",
      "placeholder": "http://trek-amap-bridge:8080",
      "hint": "与 TREK 的 PLACES_API_BASE 一致；留空则回退到 OpenStreetMap Nominatim"
    },
    {
      "key": "places_api_key",
      "label": "地图搜索 API Key",
      "input_type": "password",
      "scope": "instance",
      "secret": true,
      "hint": "与 TREK 的 PLACES_API_KEY 一致；配合上面的地址使用高德/Google Places 兼容 bridge"
    },
    {
      "key": "xhs_keyword_search",
      "label": "默认启用关键词搜索",
      "input_type": "select",
      "scope": "user",
      "default": "false",
      "hint": "开启后，生成页会默认勾选「尝试小红书关键词搜索」。仍可在每次生成时手动开关。",
      "options": [
        { "value": "true", "label": "默认启用" },
        { "value": "false", "label": "默认关闭" }
      ]
    },
    {
      "key": "xhs_cookie",
      "label": "小红书 Web Cookie",
      "input_type": "password",
      "scope": "user",
      "secret": true,
      "hint": "登录 www.xiaohongshu.com 后粘贴完整 Cookie，须含 a1 和 web_session。仅服务端使用，不会进页面或 AI。"
    }
  ],
  "actions": [
    {
      "key": "testXhs",
      "label": "测试小红书会话",
      "hint": "使用你的 Cookie 执行一次最小关键词搜索。"
    }
  ]
}
